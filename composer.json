{
  "name": "maatify/mailer",
  "description": "PHP library that renders Twig e-mail templates and sends them through SMTP (PHPMailer).",
  "keywords": [
    "mailer",
    "email",
    "smtp",
    "twig",
    "phpmailer",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/Mailer",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/Mailer/issues",
    "source": "https://github.com/Maatify/Mailer",
    "security": "https://github.com/Maatify/Mailer/security/policy"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Mailer\\": "mailer/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Mailer\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-openssl": "*",
    "maatify/logger": "^5.0 || ^7.0",
    "php": ">=8.4.27 <8.5.0 || >=8.5.12 <8.6.0",
    "phpmailer/phpmailer": "^6.10",
    "twig/twig": "^3.27"
  },
  "require-dev": {
    "phpunit/phpunit": "^11 || ^12"
  },
  "scripts": {
    "test": "phpunit",
    "test:logger-matrix": "bash scripts/verify-logger-matrix.sh"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.27"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "audit": "fail"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
